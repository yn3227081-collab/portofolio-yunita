* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    background: #f7f1ff;
    color: #333;
    line-height: 1.7;
}

/* HEADER */

header {
    background: linear-gradient(135deg, #c9a7ff, #f0c7ff);
    padding: 70px 20px;
}

.profile {
    max-width: 900px;
    margin: auto;
    display: flex;
    align-items: center;
    gap: 25px;
}

.foto {
    width: 130px;
    height: 130px;
    border-radius: 50%;
    background: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 55px;
    box-shadow: 0 8px 20px rgba(0,0,0,0.12);
}

header h1 {
    font-size: 45px;
    color: #633b91;
}

header p {
    font-size: 18px;
}

/* MENU */

nav {
    background: white;
    padding: 16px;
    text-align: center;
    position: sticky;
    top: 0;
    z-index: 10;
    box-shadow: 0 3px 10px rgba(0,0,0,0.08);
}

nav a {
    color: #633b91;
    text-decoration: none;
    font-weight: bold;
    margin: 0 15px;
}

nav a:hover {
    color: #a05dcc;
}

/* SECTION */

main {
    max-width: 950px;
    margin: auto;
    padding: 20px;
}

section {
    background: white;
    margin: 30px 0;
    padding: 35px;
    border-radius: 22px;
    box-shadow: 0 8px 25px rgba(0,0,0,0.07);
}

h2 {
    color: #633b91;
    margin-bottom: 20px;
    font-size: 27px;
}

/* CARD */

.card {
    background: #faf6ff;
    margin: 18px 0;
    padding: 22px;
    border-radius: 15px;
    border-left: 5px solid #a875d1;
}

.card h3 {
    color: #70449b;
    margin-bottom: 8px;
}

/* KEAHLIAN */

.skills {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
}

.skills div {
    text-align: center;
    padding: 25px 10px;
    background: #eee1ff;
    border-radius: 15px;
    color: #633b91;
}

/* LINK EMAIL */

#kontak a {
    color: #70449b;
    font-weight: bold;
    text-decoration: none;
}

#kontak a:hover {
    text-decoration: underline;
}

/* FOOTER */

footer {
    background: #633b91;
    color: white;
    text-align: center;
    padding: 25px;
    margin-top: 40px;
}

/* HP */

@media (max-width: 600px) {

    .profile {
        flex-direction: column;
        text-align: center;
    }

    header h1 {
        font-size: 35px;
    }

    nav a {
        margin: 0 6px;
        font-size: 13px;
    }

    section {
        padding: 25px 20px;
    }

    .skills {
        grid-template-columns: repeat(2, 1fr);
    }
}
